# Build and virtualenv
__pycache__/
*.pyc
*.pyo
.venv/

# All dotfiles/dotdirs (local tooling, IDE, CI, etc.)
.*
!.gitignore
!.gitattributes
!.gitleaksignore
# Repo CI (workflows live here; do not ignore)
!.github/
!.github/**

# Credentials and secrets
*.key
*.pem
*.env*
*.secret*
*credential*

# =============================================
# PUBLIC BRANCH: exclude development noise
# =============================================

# --- Docs: keep technical_reports, official_results, and eval kit ---
docs/*
!docs/technical_reports/
!docs/technical_reports/**
!docs/official_results/
!docs/official_results/**
!docs/EVAL_KIT.md
!docs/reference/
!docs/reference/**
# Targeted allowlist: baseline-vs-MCP retrieval-history compare gallery and
# its source report. Other docs/analysis/ siblings stay excluded.
!docs/analysis/
docs/analysis/*
!docs/analysis/compare/
!docs/analysis/compare/**
!docs/analysis/sourcegraph_baseline_vs_mcp_report.md
# Block audit files that may contain leaked credentials
docs/official_results/audits/

# --- Runs: only keep snapshots (sanitized exports) ---
runs/
!runs/
runs/*
!runs/snapshots/
!runs/snapshots/**
# Block internal symlinked traces (only export/ is public)
runs/snapshots/*/traces/
runs/snapshots/*/summary/
# Allow export/ subdirectory through
!runs/snapshots/*/export/
!runs/snapshots/*/export/**

# --- Benchmarks: suites + oracle answers are public for reproducibility ---
# Others need the task definitions and oracle/ground-truth to reproduce results.
# Internal backup copies (duplicates / pre-sanitization snapshots) stay private.
benchmarks/backups/

# --- Internal development directories ---
calibration/
configs/
data/
eval_reports/
fixtures/
jobs/
logs/
ralph/
ralph-*/
reports/
results/
sourcegraph_benchmarks/
sourcegraph_tasks/
templates/
tmp/
releases/

# --- Large external datasets ---
ccb_crossrepo/
!benchmarks/ccb_crossrepo/
harbor-ccb_crossrepo-dataset/
vendor/DependEval/
vendor/dependeval_repos/

# --- Harbor integration (private) ---
ccb_harbor/

# --- Internal infrastructure (accounts, credentials, capacity) ---
scripts/infra/

# --- Internal planning documents ---
prd_*.md
premortem_*.md

# --- Misc ---
archive/
oracle_curation_log.json
*.log
*.db
ds
browse/
